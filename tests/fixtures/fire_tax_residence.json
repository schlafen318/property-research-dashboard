  "questions": [
    {
      "id": "fire-tax-days-destination",
      "fact": "daysInDestination",
      "control": "number",
      "label": "About how many days will you spend in the destination this tax year?",
      "reason": "The destination day-count test can change your tax-residence result.",
      "acceptedValues": {"min": 0, "max": 366, "step": 1},
      "affectsRuleIds": ["synthetic-destination-days-2026"]
    },
    {
      "id": "fire-tax-destination-home",
      "fact": "destinationAvailableHome",
      "control": "select",
      "label": "Will you have a home continuously available in the destination?",
      "reason": "An available home can change the destination's domestic residence result.",
      "acceptedValues": [true, false, "unknown"],
      "affectsRuleIds": ["synthetic-destination-home-2026"]
    },
    {
      "id": "fire-tax-family-ties",
      "fact": "familyTies",
      "control": "select",
      "label": "Where will your closest family ties be?",
      "reason": "Family ties can change either country's domestic residence result.",
      "acceptedValues": ["home", "destination", "both", "neither", "unknown"],
      "affectsRuleIds": ["synthetic-destination-family-2026", "synthetic-home-family-2026"]
    },
    {
      "id": "fire-tax-economic-ties",
      "fact": "economicTies",
      "control": "select",
      "label": "Where will your main economic ties be?",
      "reason": "Economic ties can change either country's domestic residence result.",
      "acceptedValues": ["home", "destination", "both", "neither", "unknown"],
      "affectsRuleIds": ["synthetic-destination-economic-2026", "synthetic-home-economic-2026"]
    },
    {
      "id": "fire-tax-move-date",
      "fact": "moveDate",
      "control": "date",
      "label": "On what date will your move take effect?",
      "reason": "A move date is needed to calculate the supported split-year periods.",
      "acceptedValues": {"format": "YYYY-MM-DD"},
      "affectsRuleIds": ["synthetic-split-year-2026"]
    },
    {
      "id": "fire-tax-treaty-home",
      "fact": "treatyPermanentHome",
      "control": "select",
      "label": "Where will you have a permanent home for treaty purposes?",
      "reason": "The treaty applies its permanent-home test before later tie-breakers.",
      "acceptedValues": ["home", "destination", "both", "neither", "unknown"],
      "affectsRuleIds": ["synthetic-treaty-tie-breaker-2026"]
    },
    {
      "id": "fire-tax-treaty-centre",
      "fact": "treatyCentreOfVitalInterests",
      "control": "select",
      "label": "Where is your centre of personal and economic interests?",
      "reason": "This treaty tie-breaker is reached only if the permanent-home test does not decide residence.",
      "acceptedValues": ["home", "destination", "both", "neither", "unknown"],
      "affectsRuleIds": ["synthetic-treaty-tie-breaker-2026"]
    },
    {
      "id": "fire-tax-nonmaterial-theme",
      "fact": "themePreference",
      "control": "select",
      "label": "Which display theme do you prefer?",
      "reason": "This should never be asked by the tax router.",
      "acceptedValues": ["light", "dark"],
      "affectsRuleIds": ["synthetic-destination-days-2026"],
      "outcomes": {"light": "same", "dark": "same"}
    }
  ],
